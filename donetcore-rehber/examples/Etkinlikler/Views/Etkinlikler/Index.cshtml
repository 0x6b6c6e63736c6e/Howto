@model IReadOnlyList<string>
@{ Layout = null; }
<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Etkinlikler</title>
</head>
<body>
    <h1>Etkinlikler</h1>
    <ul>
        @foreach (var etkinlik in Model)
        {
            <li>@etkinlik</li>
        }
    </ul>
</body>
</html>
